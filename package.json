{
  "name": "playstate",
  "private": true,
  "version": "0.1.0",
  "description": "An offline-first live quiz platform.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @playstate/web dev",
    "build:web": "pnpm --filter @playstate/web build"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  }
}
